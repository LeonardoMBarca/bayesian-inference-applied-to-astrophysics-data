# Python bytecode and build products
__pycache__/
*.py[codz]
*$py.class
*.so
build/
dist/
*.egg-info/
.Python

# Test, coverage, and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Virtual environments and local secrets
.env
.envrc
.venv/
venv/
env/
ENV/
.pixi/
__pypackages__/

# Editors and notebooks
.idea/
.vscode/
.ipynb_checkpoints/
.spyderproject
.spyproject
.ropeproject
.cursorignore
.cursorindexingignore

# Generated logs and temporary files
*.log
*.tmp
*.part
artifacts/publication_campaign/**/campaign.lock
pip-log.txt

# Scientific run products too large for ordinary Git. Structured summaries,
# configs, manifests, tables, reports, and small validation figures stay tracked.
*.nc
models/**/trace.nc

# Large regenerated data products are managed by provenance manifests and the
# storage policy documented in docs/STORAGE_POLICY.md. The published Gold
# transit window, compact diagnostics, metadata, and catalogs remain tracked.
data/silver/lightcurves/mast/*/*_lightcurve.csv
data/gold/*/lightcurves/*.csv
data/gold/*/modeling/phase_folded_lightcurve.csv
data/gold/*/modeling/segment_normalized_lightcurve.csv
data/experiments/**/injected_lightcurve.csv
# Full publication intermediates are preserved locally and checksum-bound in
# reports/publication_synthesis/tcc_evidence_v1/STORAGE_MANIFEST.json. Their
# external archive/restoration remains a release prerequisite.
publication/observational/PUB-05/**/silver_lightcurve.csv
publication/observational/PUB-05/**/gold_lightcurve.csv

# Failed derived render retained locally; its failure receipt stays versioned.
reports/publication_synthesis/tcc_evidence_v1_failed_render_001/*
!reports/publication_synthesis/tcc_evidence_v1_failed_render_001/INCOMPLETE_RENDER.md
# Local previews and incomplete staging areas are not sealed paper artifacts.
reports/publication_synthesis/render-smoke-*/
reports/publication_synthesis/.synthesis-render-*/

# Optional notebook/application caches
marimo/_static/
marimo/_lsp/
__marimo__/
site/
docs/_build/

# Administrative PDFs and individually watermarked course materials are not
# research inputs. Keep local originals outside the public repository.
/tcc-docs/*.pdf
/private-documents/
/local-documents/
# This prevents accidental re-addition; it does NOT remove existing Git history.
