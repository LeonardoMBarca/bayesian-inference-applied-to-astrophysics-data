# Baseline/pipeline/environment evidence also has exact-byte identities.
data/silver/** -text -filter -ident -working-tree-encoding
data/gold/** -text -filter -ident -working-tree-encoding
models/bayesian_physical_transit/kepler_10_b/runs/scientific_003/** -text -filter -ident -working-tree-encoding
tables/bayesian_physical_transit/kepler_10_b/runs/scientific_003/** -text -filter -ident -working-tree-encoding
