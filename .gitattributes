artifacts/publication_campaign/**/*.csv text eol=lf
reports/publication_campaign/** text eol=lf
reports/publication_synthesis/** -text
tests/**/*.py text eol=lf
docs/publication/*.json text eol=lf
docs/publication/*.md text eol=lf
CITATION.cff text eol=lf
REPRODUCIBILITY_MANIFEST.json text eol=lf
publication/engineering/** -text
publication/experiments/** -text
publication/observational/** -text
artifacts/publication_campaign/** -text
logs/publication_campaign/** -text
publication/validation/**/*.txt text eol=lf
reports/PUBLICATION_CAMPAIGN_HANDOFF.md text eol=lf
publication/environments/* -text
*.fits binary
*.png binary
